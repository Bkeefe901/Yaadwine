{% macro published(post) %}
<div class="story-card status-next">
  <span class="status-tag">Read Now</span>
  <h3><a href="{{ post.url }}" style="color: inherit; text-decoration: none;">{{ post.data.cardTitle }}</a></h3>
  <p class="human-question">{{ post.data.humanQuestion }}</p>
</div>
{% endmacro %}

{% macro comingSoon(card) %}
<div class="story-card status-planned">
  <span class="status-tag">Coming Soon</span>
  <h3>{{ card.title }}</h3>
  <p class="human-question">{{ card.humanQuestion }}</p>
</div>
{% endmacro %}
