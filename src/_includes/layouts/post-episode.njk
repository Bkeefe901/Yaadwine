---
layout: layouts/base.njk
extraStyles: ["episode"]
ogType: article
---
<main class="episode-page">
  <section class="episode-hero">
    <p class="eyebrow">{{ eyebrow }}</p>
    <h1>{{ heroTitle | safe }}</h1>
    {% if heroStamps %}
    <div class="stamp-row" aria-hidden="true">
      {% for stamp in heroStamps %}
      <span class="stamp">{{ stamp }}</span>
      {% if not loop.last %}<span class="stamp-line"></span>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <article class="episode-body">
    {{ content | safe }}
  </article>

  <section class="episode-close">
    <div class="stamp-row" aria-hidden="true">
      {% for stamp in closeStamps %}
      <span class="stamp filled{% if stamp.outline %} outline{% endif %}">{{ stamp.label }}</span>
      {% if not loop.last %}<span class="stamp-line"></span>{% endif %}
      {% endfor %}
    </div>
    <p class="tagline">{{ tagline | safe }}</p>
    <a href="cellar.html" class="btn btn-ghost">Explore more stories in the Cellar</a>
    <br />
  </section>
  <div class="convo-starter">
    <p class="thoughts-tag">Got thoughts on this one? Come tell us on Instagram.</p>
    <b class="convo-link"><a href="https://instagram.com/yaadwine_">@yaadwine_</a></b>
  </div>
</main>
